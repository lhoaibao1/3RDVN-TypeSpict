// 3RD Fintech CRM - Prisma Schema (expanded Phase 1+2)
// Ported from Laravel + Filament CRM

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id                    Int       @id @default(autoincrement())
  uid                   String?   @unique
  username              String?   @unique
  name                  String
  email                 String    @unique
  employeeCode          String?   @unique @map("employee_code")
  phone                 String?
  password              String
  avatarPath            String?   @map("avatar_path")

  documentType          String?   @map("document_type")
  dateOfBirth           DateTime? @map("date_of_birth")
  gender                String?
  identityNumber        String?   @map("identity_number")
  identityIssuedDate    DateTime? @map("identity_issued_date")
  identityIssuedPlace   String?   @map("identity_issued_place")

  department            String?
  position              String?
  employmentStatus      String    @default("active") @map("employment_status")
  hireDate              DateTime? @map("hire_date")
  office                String?
  contractType          String?   @map("contract_type")

  salesProjects         String?   @map("sales_projects")
  salesCodes            String?   @map("sales_codes")
  companyName           String?   @map("company_name")
  branchName            String?   @map("branch_name")
  branchCode            String?   @map("branch_code")
  salesChannel          String?   @map("sales_channel")

  teamId                Int?      @map("team_id")
  teamLeaderId          Int?      @map("team_leader_id")
  courierManagerId      Int?      @map("courier_manager_id")
  amId                  Int?      @map("am_id")
  zdId                  Int?      @map("zd_id")
  createdById           Int?      @map("created_by_id")

  addressLine           String?   @map("address_line")
  provinceCode          String?   @map("province_code")
  provinceName          String?   @map("province_name")
  districtCode          String?   @map("district_code")
  districtName          String?   @map("district_name")
  wardCode              String?   @map("ward_code")
  wardName              String?   @map("ward_name")

  bankCode              String?   @map("bank_code")
  bankName              String?   @map("bank_name")
  bankAccountNumber     String?   @map("bank_account_number")
  bankAccountName       String?   @map("bank_account_name")
  bankBranch            String?   @map("bank_branch")

  taxCode               String?   @map("tax_code")
  socialInsuranceNumber String?   @map("social_insurance_number")
  emergencyContactName  String?   @map("emergency_contact_name")
  emergencyContactPhone String?   @map("emergency_contact_phone")

  mailAddress           String?   @map("mail_address")
  mailStatus            String?   @default("not_created") @map("mail_status")

  emailVerifiedAt       DateTime? @map("email_verified_at")
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  team                  CrmTeam?  @relation("UserTeam", fields: [teamId], references: [id])
  managedTeam           CrmTeam?  @relation("TeamManager")
  teamLeader            User?     @relation("TeamLeader", fields: [teamLeaderId], references: [id])
  teamMembers           User[]    @relation("TeamLeader")
  courierManager        User?     @relation("CourierManager", fields: [courierManagerId], references: [id])
  courierManaged        User[]    @relation("CourierManager")
  am                    User?     @relation("AM", fields: [amId], references: [id])
  amManaged             User[]    @relation("AM")
  zd                    User?     @relation("ZD", fields: [zdId], references: [id])
  zdManaged             User[]    @relation("ZD")
  creator               User?     @relation("Creator", fields: [createdById], references: [id])
  createdUsers          User[]    @relation("Creator")

  roles                 UserRole[]
  assignedLeads         Lead[]    @relation("AssignedSale")
  createdLeads          Lead[]    @relation("LeadCreator")
  convertedLeads        Lead[]    @relation("LeadConverter")
  teamLeaderLeads       Lead[]    @relation("LeadTeamLeader")
  amLeads               Lead[]    @relation("LeadAM")
  zdLeads               Lead[]    @relation("LeadZD")

  ownedSaleProfiles     SaleProfile[] @relation("SaleOwner")
  approvedSaleProfiles  SaleProfile[] @relation("SaleApprover")
  processingSaleProfiles SaleProfile[] @relation("SaleProcessor")
  assignedApplications  Application[] @relation("AppAssignedSale")
  createdApplications   Application[] @relation("AppCreator")
  assignedDcLeads       DataCenterLead[] @relation("DcAssigned")
  createdDcLeads        DataCenterLead[] @relation("DcCreator")

  @@map("users")
}

model Role {
  id          Int        @id @default(autoincrement())
  name        String     @unique
  guardName   String     @default("web") @map("guard_name")
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  users       UserRole[]
  permissions RolePermission[]
  @@map("roles")
}

model Permission {
  id          Int              @id @default(autoincrement())
  name        String           @unique
  guardName   String           @default("web") @map("guard_name")
  createdAt   DateTime         @default(now()) @map("created_at")
  updatedAt   DateTime         @updatedAt @map("updated_at")
  roles       RolePermission[]
  @@map("permissions")
}

model UserRole {
  userId Int  @map("user_id")
  roleId Int  @map("role_id")
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model CrmTeam {
  id          Int      @id @default(autoincrement())
  name        String
  code        String?  @unique
  managerId   Int?     @unique @map("manager_id")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  manager     User?    @relation("TeamManager", fields: [managerId], references: [id])
  members     User[]   @relation("UserTeam")
  leads       Lead[]
  saleProfiles SaleProfile[]
  applications Application[]
  dcLeads     DataCenterLead[]
  @@map("crm_teams")
}

model Lead {
  id                      Int       @id @default(autoincrement())
  leadCode                String?   @unique @map("lead_code")
  salesProjectId          Int?      @map("sales_project_id")
  leadName                String    @map("lead_name")
  phone                   String?
  email                   String?
  source                  String?
  assignedSaleId          Int?      @map("assigned_sale_id")
  createdById             Int?      @map("created_by_id")
  teamId                  Int?      @map("team_id")
  teamLeaderId            Int?      @map("team_leader_id")
  amId                    Int?      @map("am_id")
  zdId                    Int?      @map("zd_id")
  status                  String    @default("Mới")
  note                    String?
  payload                 String?
  convertedSaleProfileId  Int?      @map("converted_sale_profile_id")
  convertedAt             DateTime? @map("converted_at")
  convertedById           Int?      @map("converted_by_id")
  createdAt               DateTime  @default(now()) @map("created_at")
  updatedAt               DateTime  @updatedAt @map("updated_at")
  deletedAt               DateTime? @map("deleted_at")

  assignedSale            User?     @relation("AssignedSale", fields: [assignedSaleId], references: [id])
  createdBy               User?     @relation("LeadCreator", fields: [createdById], references: [id])
  convertedBy             User?     @relation("LeadConverter", fields: [convertedById], references: [id])
  team                    CrmTeam?  @relation(fields: [teamId], references: [id])
  teamLeader              User?     @relation("LeadTeamLeader", fields: [teamLeaderId], references: [id])
  am                      User?     @relation("LeadAM", fields: [amId], references: [id])
  zd                      User?     @relation("LeadZD", fields: [zdId], references: [id])
  salesProject            SalesProject? @relation(fields: [salesProjectId], references: [id])
  applications            Application[]
  saleProfiles            SaleProfile[] @relation("SourceLead")
  @@map("leads")
}

model SalesProject {
  id          Int      @id @default(autoincrement())
  name        String
  code        String?  @unique
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  formSchema  String?  @map("form_schema")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  leads       Lead[]
  channels    SalesChannel[]
  applications Application[]
  @@map("sales_projects")
}

model SalesChannel {
  id             Int      @id @default(autoincrement())
  name           String
  code           String?  @unique
  salesProjectId Int?     @map("sales_project_id")
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  salesProject   SalesProject? @relation(fields: [salesProjectId], references: [id])
  @@map("sales_channels")
}

model SaleProfile {
  id                 Int       @id @default(autoincrement())
  customerName       String    @map("customer_name")
  phone              String?
  email              String?
  identityNumber     String?   @map("identity_number")
  address            String?
  productInterest    String?   @map("product_interest")
  saleOwnerId        Int?      @map("sale_owner_id")
  teamId             Int?      @map("team_id")
  status             String    @default("Mới")
  approvalStatus     String?   @default("pending") @map("approval_status")
  note               String?
  sourceLeadId       Int?      @map("source_lead_id")
  rejectionReason    String?   @map("rejection_reason")
  approvedById       Int?      @map("approved_by_id")
  approvedAt         DateTime? @map("approved_at")
  processingOwnerId  Int?      @map("processing_owner_id")
  processingStatus   String?   @map("processing_status")
  completedAt        DateTime? @map("completed_at")
  createdAt          DateTime  @default(now()) @map("created_at")
  updatedAt          DateTime  @updatedAt @map("updated_at")
  deletedAt          DateTime? @map("deleted_at")

  saleOwner          User?     @relation("SaleOwner", fields: [saleOwnerId], references: [id])
  approvedBy         User?     @relation("SaleApprover", fields: [approvedById], references: [id])
  processingOwner    User?     @relation("SaleProcessor", fields: [processingOwnerId], references: [id])
  sourceLead         Lead?     @relation("SourceLead", fields: [sourceLeadId], references: [id])
  team               CrmTeam?  @relation(fields: [teamId], references: [id])
  @@map("sale_profiles")
}

model Application {
  id               Int       @id @default(autoincrement())
  salesProjectId   Int?      @map("sales_project_id")
  leadId           Int?      @map("lead_id")
  applicationCode  String?   @unique @map("application_code")
  applicantName    String    @map("applicant_name")
  phone            String?
  identityNumber   String?   @map("identity_number")
  status           String    @default("Mới")
  assignedSaleId   Int?      @map("assigned_sale_id")
  createdById      Int?      @map("created_by_id")
  teamId           Int?      @map("team_id")
  teamLeaderId     Int?      @map("team_leader_id")
  amId             Int?      @map("am_id")
  zdId             Int?      @map("zd_id")
  payload          String?
  note             String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  salesProject     SalesProject? @relation(fields: [salesProjectId], references: [id])
  lead             Lead?     @relation(fields: [leadId], references: [id])
  assignedSale     User?     @relation("AppAssignedSale", fields: [assignedSaleId], references: [id])
  createdBy        User?     @relation("AppCreator", fields: [createdById], references: [id])
  team             CrmTeam?  @relation(fields: [teamId], references: [id])
  @@map("applications")
}

model DataCenterLead {
  id               Int       @id @default(autoincrement())
  referralCode     String?   @unique @map("referral_code")
  customerName     String    @map("customer_name")
  phone            String?
  email            String?
  identityNumber   String?   @map("identity_number")
  dateOfBirth      DateTime? @map("date_of_birth")
  address          String?
  provinceCode     String?   @map("province_code")
  provinceName     String?   @map("province_name")
  districtCode     String?   @map("district_code")
  districtName     String?   @map("district_name")
  wardCode         String?   @map("ward_code")
  wardName         String?   @map("ward_name")
  source           String?
  status           String    @default("Mới")
  callNote         String?   @map("call_note")
  contactedAt      DateTime? @map("contacted_at")
  assignedUserId   Int?      @map("assigned_user_id")
  createdById      Int?      @map("created_by_id")
  teamId           Int?      @map("team_id")
  teamLeaderId     Int?      @map("team_leader_id")
  amId             Int?      @map("am_id")
  zdId             Int?      @map("zd_id")
  payload          String?
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")

  assignedUser     User?     @relation("DcAssigned", fields: [assignedUserId], references: [id])
  createdBy        User?     @relation("DcCreator", fields: [createdById], references: [id])
  team             CrmTeam?  @relation(fields: [teamId], references: [id])
  @@map("data_center_leads")
}

model JobVacancy {
  id          Int      @id @default(autoincrement())
  title       String
  slug        String   @unique
  description String?
  requirements String?
  location    String?
  salaryRange String?  @map("salary_range")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  applications CandidateApplication[]
  @@map("job_vacancies")
}

model CandidateApplication {
  id            Int       @id @default(autoincrement())
  jobVacancyId  Int?      @map("job_vacancy_id")
  fullName      String    @map("full_name")
  phone         String?
  email         String?
  cvPath        String?   @map("cv_path")
  status        String    @default("Mới")
  note          String?
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  jobVacancy    JobVacancy? @relation(fields: [jobVacancyId], references: [id])
  @@map("candidate_applications")
}
